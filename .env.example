# Finnhub API Key (required) — get free at https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Twelve Data API Key for EMA/SMA candles (optional, demo works for testing)
TWELVEDATA_API_KEY=demo

# Telegram Bot Token (optional — for delivery)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (optional — for delivery)
TELEGRAM_CHAT_ID=

# Gap threshold (default: 0.50 = 50%)
GAP_THRESHOLD=0.50

# Enable EMA/SMA indicators (requires Twelve Data)
ENRICH_WITH_INDICATORS=1
